# Static analysis for the library sources (run with the `tidy` CMake preset).
# modernize-macro-to-enum is off: the public C headers need macros usable in #if (RCA_VERSION_*).
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -modernize-macro-to-enum,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers
HeaderFilterRegex: '.*/(include/rca|src)/.*'
FormatStyle: file
